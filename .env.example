# Required: shared secret for Bridge HTTP API (Bearer token)
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Optional: public base URL (used in Muse connector templates / logs)
PUBLIC_BASE_URL=http://127.0.0.1:8787

# HTTP API listen port (also serves /mcp when MCP_PORT is unset or equal)
PORT=8787

# Optional separate MCP streamable-HTTP port (default: same as PORT)
# MCP_PORT=8788

# Grok Bot webhook Routine credentials (outbound Muse → Grok delivery)
# Copy "POST to" and "key" from the Bot's webhook routine panel on desktop.
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=

# Storage: memory | json | sqlite (sqlite uses better-sqlite3 when available)
STORE_BACKEND=json
# STORE_PATH=./data/bridge.json
# For sqlite: STORE_PATH=./data/bridge.db

# EXPERIMENTAL: if true and `muse-cli` is on PATH, attempt CLI push into Muse.
# May violate Muse ToS — use at your own risk. Default off.
MUSE_CLI_ENABLED=false
# MUSE_CLI_BIN=muse-cli
